					"200": {
						"description": "successful operation",
						"schema": {
							"type": "array",
							"items": {
								"$ref": "#/definitions/AmlScreening"
							}
						}
					},
					"400": {
						"description": "Invalid request"
					}
				},
				"security": [
					{
						"api_key": []
					}
				]
			},
			"post": {
				"tags": ["aml"],
				"summary": "Create a new AML screening",
				"description": "Perform AML screening for a customer",
				"operationId": "createAmlScreening",
				"consumes": ["application/json"],
				"produces": ["application/json"],
