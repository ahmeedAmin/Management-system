        "customer": {
          "$ref": "#/definitions/CoreCustomerDTO"
        }
      },
      "additionalProperties": false
    },
    "CoreCustomer": {
      "required": [
        "branchCode",
        "dob",
        "gender",
        "mobile",
        "nameAr"
      ],
      "type": "object",
      "properties": {
        "cif": {
          "type": "integer",
          "format": "int64"
        },
        "nationalID": {
          "type": "string",
          "maxLength": 14,
          "minLength": 0
        },
        "passportNo": {
          "type": "string",
          "maxLength": 30,
          "minLength": 0
        },
        "nameAr": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0
        },
        "nameEn": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0
        },
        "dob": {
          "type": "string",
          "format": "date"
        },
        "gender": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "maxLength": 400,
          "minLength": 0
        },
        "mobile": {
          "type": "string",
          "maxLength": 20,
          "minLength": 0
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "minLength": 0
        },
        "branchCode": {
          "type": "string",
          "maxLength": 10,
          "minLength": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoreAccount"
          }
        }
      },
      "additionalProperties": false
    },
