{
  "swagger": "2.0",
  "info": {
    "title": "Banking API",
    "version": "2.0.0",
    "description": "Swagger 2.0 spec for Nintex integration covering Controllers/Models/DTOs exactly. Note: path alias /api/Ecm/Folders/cif/{cif} is used to avoid equivalent path conflicts in Swagger v2."
  },
  "host": "el-barka.runasp.net",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/api/Aml": {
      "get": {
        "summary": "Get all AML screenings",
        "operationId": "Aml_GetAllScreenings",
        "responses": {
          "200": {
            "description": "List of AML screenings",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/AmlScreening" } }
          }
        }
      },
      "post": {
        "summary": "Create AML screening (screen customer)",
        "operationId": "Aml_ScreenCustomer",
        "parameters": [
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/AmlScreening" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/AmlScreening" } },
          "400": { "description": "Bad Request" }
        }
      }
    },
    "/api/Aml/{id}": {
      "get": {
        "summary": "Get AML screening by ID",
        "operationId": "Aml_GetScreeningById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" }
        ],
        "responses": {
          "200": { "description": "Screening found", "schema": { "$ref": "#/definitions/AmlScreening" } },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "summary": "Update AML screening",
        "operationId": "Aml_UpdateScreening",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/AmlScreening" } }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "summary": "Delete AML screening",
        "operationId": "Aml_DeleteScreening",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/Aml/NationalId/{nationalId}": {
      "get": {
        "summary": "Get AML screenings by National ID",
        "operationId": "Aml_GetScreeningsByNationalId",
        "parameters": [
          { "name": "nationalId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "List of screenings", "schema": { "type": "array", "items": { "$ref": "#/definitions/AmlScreening" } } },
          "404": { "description": "Not Found" }
        }
      }
    },

    "/api/CoreAccount": {
      "get": {
        "summary": "Get all accounts (with optional embedded customer)",
        "operationId": "CoreAccount_GetAll",
        "responses": {
          "200": { "description": "List of accounts (DTO)", "schema": { "type": "array", "items": { "$ref": "#/definitions/CoreAccountDTO" } } }
        }
      },
      "post": {
        "summary": "Create account",
        "operationId": "CoreAccount_Create",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/CoreAccount" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/CreateAccountResponse" } },
          "400": { "description": "Bad Request" }
        }
      }
    },
    "/api/CoreAccount/{accountNumber}": {
      "get": {
        "summary": "Get account by AccountNumber",
        "operationId": "CoreAccount_GetByAccountNumber",
        "parameters": [
          { "name": "accountNumber", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Account (DTO)", "schema": { "$ref": "#/definitions/CoreAccountDTO" } },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "summary": "Modify account (full update)",
        "operationId": "CoreAccount_Modify",
        "parameters": [
          { "name": "accountNumber", "in": "path", "required": true, "type": "string" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/CoreAccount" } }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "summary": "Delete account",
        "operationId": "CoreAccount_Delete",
        "parameters": [
          { "name": "accountNumber", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/CoreAccount/{accountNumber}/RemoveDebitBlock": {
      "patch": {
        "summary": "Remove debit block by account number",
        "operationId": "CoreAccount_RemoveDebitBlock",
        "parameters": [
          { "name": "accountNumber", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found" }
        }
      }
    },

    "/api/CoreCustomer": {
      "get": {
        "summary": "Get all customers (with accounts)",
        "operationId": "CoreCustomer_GetAll",
        "responses": {
          "200": { "description": "List of customers (DTO)", "schema": { "type": "array", "items": { "$ref": "#/definitions/CoreCustomerDTO" } } }
        }
      },
      "post": {
        "summary": "Create customer",
        "operationId": "CoreCustomer_Create",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/CoreCustomer" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/CreateCustomerResponse" } },
          "400": { "description": "Bad Request" }
        }
      }
    },
    "/api/CoreCustomer/CIF/{cif}": {
      "get": {
        "summary": "Get customer by CIF",
        "operationId": "CoreCustomer_GetByCif",
        "parameters": [
          { "name": "cif", "in": "path", "required": true, "type": "integer", "format": "int64" }
        ],
        "responses": {
          "200": { "description": "Customer (DTO)", "schema": { "$ref": "#/definitions/CoreCustomerDTO" } },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/CoreCustomer/{cif}": {
      "put": {
        "summary": "Update customer",
        "operationId": "CoreCustomer_Update",
        "parameters": [
          { "name": "cif", "in": "path", "required": true, "type": "integer", "format": "int64" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/CoreCustomer" } }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "summary": "Delete customer",
        "operationId": "CoreCustomer_Delete",
        "parameters": [
          { "name": "cif", "in": "path", "required": true, "type": "integer", "format": "int64" }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/CoreCustomer/NationalId/{nationalId}": {
      "get": {
        "summary": "Get customer by National ID",
        "operationId": "CoreCustomer_GetByNationalId",
        "parameters": [
          { "name": "nationalId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Customer (DTO)", "schema": { "$ref": "#/definitions/CoreCustomerDTO" } },
          "404": { "description": "Not Found" }
        }
      }
    },

    "/api/Ecm/Folders": {
      "get": {
        "summary": "Get all ECM folders (with documents)",
        "operationId": "Ecm_GetAllFolders",
        "responses": {
          "200": { "description": "List of folders (DTO)", "schema": { "type": "array", "items": { "$ref": "#/definitions/EcmFolderDTO" } } }
        }
      },
      "post": {
        "summary": "Create ECM folder",
        "operationId": "Ecm_CreateFolder",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/EcmFolder" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/EcmFolder" } },
          "400": { "description": "Bad Request" }
        }
      }
    },
    "/api/Ecm/Folders/cif/{cif}": {
      "get": {
        "summary": "Get ECM folders by CIF",
        "operationId": "Ecm_GetFoldersByCif",
        "parameters": [
          { "name": "cif", "in": "path", "required": true, "type": "integer", "format": "int64" }
        ],
        "responses": {
          "200": { "description": "List of folders (DTO)", "schema": { "type": "array", "items": { "$ref": "#/definitions/EcmFolderDTO" } } },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/Ecm/Folders/{id}": {
      "put": {
        "summary": "Update ECM folder",
        "operationId": "Ecm_UpdateFolder",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/EcmFolder" } }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "summary": "Delete ECM folder",
        "operationId": "Ecm_DeleteFolder",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found" }
        }
      }
    },

    "/api/Ecm/Folders/{folderId}/{requestId}/Documents": {
      "get": {
        "summary": "Get documents by FolderId and RequestId",
        "operationId": "Ecm_GetDocumentsByFolderAndRequest",
        "parameters": [
          { "name": "folderId", "in": "path", "required": true, "type": "string", "format": "uuid" },
          { "name": "requestId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "List of documents", "schema": { "type": "array", "items": { "$ref": "#/definitions/EcmDocument" } } },
          "404": { "description": "Not Found" }
        }
      }
    },

    "/api/Ecm/Documents": {
      "get": {
        "summary": "Get all ECM documents (with optional folder)",
        "operationId": "Ecm_GetAllDocuments",
        "responses": {
          "200": { "description": "List of documents (DTO)", "schema": { "type": "array", "items": { "$ref": "#/definitions/EcmDocumentDTO" } } }
        }
      },
      "post": {
        "summary": "Upload ECM document",
        "operationId": "Ecm_UploadDocument",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/EcmDocument" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/EcmDocument" } },
          "400": { "description": "Bad Request" }
        }
      }
    },
    "/api/Ecm/Documents/{id}": {
      "get": {
        "summary": "Get ECM document by ID",
        "operationId": "Ecm_GetDocumentById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" }
        ],
        "responses": {
          "200": { "description": "Document (DTO)", "schema": { "$ref": "#/definitions/EcmDocumentDTO" } },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "summary": "Update ECM document",
        "operationId": "Ecm_UpdateDocument",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/EcmDocument" } }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "summary": "Delete ECM document",
        "operationId": "Ecm_DeleteDocument",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/Ecm/Documents/{id}/Status": {
      "get": {
        "summary": "Get status of ECM document",
        "operationId": "Ecm_FetchDocStatus",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid" }
        ],
        "responses": {
          "200": { "description": "Status string", "schema": { "type": "string" } },
          "404": { "description": "Not Found" }
        }
      }
    }
  },
  "definitions": {
    "AmlScreening": {
      "type": "object",
      "required": ["RiskScore", "RiskLevel"],
      "properties": {
        "ScreeningId": { "type": "string", "format": "uuid" },
        "NationalID": { "type": "string", "maxLength": 14 },
        "PassportNo": { "type": "string", "maxLength": 30 },
        "NameAr": { "type": "string", "maxLength": 200 },
        "NameEn": { "type": "string", "maxLength": 200 },
        "RiskScore": { "type": "integer", "format": "int32" },
        "RiskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"], "maxLength": 10 },
        "HitsCount": { "type": "integer", "format": "int32" },
        "PerformedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CoreAccount": {
      "type": "object",
      "required": ["AccountNumber", "CIF", "AccountType", "Currency"],
      "properties": {
        "AccountNumber": { "type": "string", "maxLength": 20 },
        "CIF": { "type": "integer", "format": "int64" },
        "AccountType": { "type": "string", "maxLength": 30 },
        "Currency": { "type": "string", "maxLength": 3 },
        "DebitBlocked": { "type": "boolean" },
        "ProductCode": { "type": "string", "maxLength": 30 },
        "CreatedAt": { "type": "string", "format": "date-time" },
        "Customer": { "$ref": "#/definitions/CoreCustomer" }
      }
    },
    "CoreCustomer": {
      "type": "object",
      "required": ["NameAr", "DOB", "Gender", "Mobile", "BranchCode"],
      "properties": {
        "CIF": { "type": "integer", "format": "int64" },
        "NationalID": { "type": "string", "maxLength": 14 },
        "PassportNo": { "type": "string", "maxLength": 30 },
        "NameAr": { "type": "string", "maxLength": 200 },
        "NameEn": { "type": "string", "maxLength": 200 },
        "DOB": { "type": "string", "format": "date" },
        "Gender": { "type": "string", "enum": ["M", "F"], "maxLength": 1 },
        "Address": { "type": "string", "maxLength": 400 },
        "Mobile": { "type": "string", "maxLength": 20 },
        "Email": { "type": "string" },
        "BranchCode": { "type": "string", "maxLength": 10 },
        "CreatedAt": { "type": "string", "format": "date-time" },
        "Accounts": { "type": "array", "items": { "$ref": "#/definitions/CoreAccount" } }
      }
    },
    "EcmFolder": {
      "type": "object",
      "required": ["FolderId", "CIF", "RequestId"],
      "properties": {
        "FolderId": { "type": "string", "format": "uuid" },
        "CIF": { "type": "integer", "format": "int64" },
        "RequestId": { "type": "string", "maxLength": 50 },
        "PathHint": { "type": "string", "maxLength": 500 },
        "CreatedAt": { "type": "string", "format": "date-time" },
        "Documents": { "type": "array", "items": { "$ref": "#/definitions/EcmDocument" } }
      }
    },
    "EcmDocument": {
      "type": "object",
      "required": ["DocumentId", "FolderId", "RequestId", "DocType", "FileName"],
      "properties": {
        "DocumentId": { "type": "string", "format": "uuid" },
        "FolderId": { "type": "string", "format": "uuid" },
        "RequestId": { "type": "string", "maxLength": 50 },
        "DocType": { "type": "string", "maxLength": 50 },
        "FileName": { "type": "string", "maxLength": 255 },
        "UploadedAt": { "type": "string", "format": "date-time" },
        "Folder": { "$ref": "#/definitions/EcmFolder" }
      }
    },

    "CoreAccountDTO": {
      "type": "object",
      "properties": {
        "AccountNumber": { "type": "string" },
        "CIF": { "type": "integer", "format": "int64" },
        "AccountType": { "type": "string" },
        "Currency": { "type": "string" },
        "DebitBlocked": { "type": "boolean" },
        "ProductCode": { "type": "string" },
        "CreatedAt": { "type": "string", "format": "date-time" },
        "Customer": { "$ref": "#/definitions/CoreCustomerDTO" }
      }
    },
    "CoreCustomerDTO": {
      "type": "object",
      "properties": {
        "CIF": { "type": "integer", "format": "int64" },
        "NationalID": { "type": "string" },
        "PassportNo": { "type": "string" },
        "NameAr": { "type": "string" },
        "NameEn": { "type": "string" },
        "DOB": { "type": "string", "format": "date" },
        "Gender": { "type": "string", "enum": ["M", "F"] },
        "Address": { "type": "string" },
        "Mobile": { "type": "string" },
        "Email": { "type": "string" },
        "BranchCode": { "type": "string" },
        "CreatedAt": { "type": "string", "format": "date-time" },
        "Accounts": { "type": "array", "items": { "$ref": "#/definitions/CoreAccountDTO" } }
      }
    },
    "EcmFolderDTO": {
      "type": "object",
      "properties": {
        "FolderId": { "type": "string", "format": "uuid" },
        "CIF": { "type": "integer", "format": "int64" },
        "RequestId": { "type": "string" },
        "PathHint": { "type": "string" },
        "CreatedAt": { "type": "string", "format": "date-time" },
        "Documents": { "type": "array", "items": { "$ref": "#/definitions/EcmDocumentDTO" } }
      }
    },
    "EcmDocumentDTO": {
      "type": "object",
      "properties": {
        "DocumentId": { "type": "string", "format": "uuid" },
        "FolderId": { "type": "string", "format": "uuid" },
        "RequestId": { "type": "string" },
        "DocType": { "type": "string" },
        "FileName": { "type": "string" },
        "UploadedAt": { "type": "string", "format": "date-time" },
        "Folder": { "$ref": "#/definitions/EcmFolderDTO" }
      }
    },

    "CreateAccountResponse": {
      "type": "object",
      "properties": {
        "accountNumber": { "type": "string" },
        "debitBlocked": { "type": "boolean" }
      }
    },
    "CreateCustomerResponse": {
      "type": "object",
      "properties": {
        "cif": { "type": "integer", "format": "int64" }
      }
    }
  }
}

