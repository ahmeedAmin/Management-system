      },
      {
        "name": "requestId",
        "in": "path",
        "description": "Request ID associated with documents",
        "required": true,
        "type": "string"
      }
    ],
    "responses": {
      "200": {
        "description": "successful operation",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EcmDocumentDTO"
          }
        }
      },
      "400": {
        "description": "Invalid folder ID or request ID supplied"
      },
      "404": {
        "description": "Documents not found"
      }
    },
    "security": [
      {
        "banking_auth": ["read:documents"]
      }
    ]
  }
},
		"/Ecm/Documents": {
			"get": {
				"tags": ["document"],
				"summary": "Get all documents",
				"description": "Retrieve all documents",
				"operationId": "getAllDocuments",
				"produces": ["application/json"],
				"responses": {
					"200": {
						"description": "successful operation",
						"schema": {
							"type": "array",
							"items": {
								"$ref": "#/definitions/EcmDocumentDTO"
							}
						}
					}
				},
				"security": [
					{
						"api_key": []
					}
				]
			},
			"post": {
				"tags": ["document"],
				"summary": "Upload a document",
				"description": "Upload a new document to the system",
				"operationId": "uploadDocument",
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"parameters": [
					{
						"in": "body",
						"name": "body",
						"description": "Document object to upload",
						"required": true,
						"schema": {
							"$ref": "#/definitions/EcmDocument"
						}
					}
				],
				"responses": {
					"200": {
						"description": "successful operation",
						"schema": {
							"$ref": "#/definitions/EcmDocument"
						}
					},
					"405": {
						"description": "Invalid input"
					}
				},
				"security": [
					{
						"banking_auth": ["write:documents", "read:documents"]
					}
				]
			}
		},
		"/Ecm/Documents/{id}": {
			"get": {
				"tags": ["document"],
				"summary": "Get document by ID",
				"description": "Retrieve a specific document by ID",
				"operationId": "getDocumentById",
				"produces": ["application/json"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID of document to return",
						"required": true,
						"type": "string",
						"format": "uuid"
					}
				],
				"responses": {
					"200": {
						"description": "successful operation",
						"schema": {
							"$ref": "#/definitions/EcmDocumentDTO"
						}
					},
					"400": {
						"description": "Invalid ID supplied"
					},
					"404": {
						"description": "Document not found"
					}
				},
				"security": [
					{
						"banking_auth": ["read:documents"]
					}
				]
			},
			"put": {
				"tags": ["document"],
				"summary": "Update an existing document",
				"description": "Update document information",
				"operationId": "updateDocument",
				"consumes": ["application/json"],
				"produces": ["application/json"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID of document that needs to be updated",
						"required": true,
						"type": "string",
						"format": "uuid"
					},
					{
						"in": "body",
						"name": "body",
						"description": "Updated document object",
						"required": true,
						"schema": {
							"$ref": "#/definitions/EcmDocument"
						}
					}
				],
				"responses": {
					"200": {
						"description": "successful operation"
					},
					"400": {
						"description": "Invalid ID supplied"
					},
					"404": {
						"description": "Document not found"
					},
					"405": {
						"description": "Validation exception"
					}
				},
				"security": [
					{
						"banking_auth": ["write:documents", "read:documents"]
					}
				]
			},
			"delete": {
				"tags": ["document"],
				"summary": "Delete document",
				"description": "Delete a document",
				"operationId": "deleteDocument",
				"produces": ["application/json"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Document ID to delete",
						"required": true,
						"type": "string",
						"format": "uuid"
					}
				],
				"responses": {
					"200": {
						"description": "successful operation"
					},
					"400": {
						"description": "Invalid ID supplied"
					},
					"404": {
						"description": "Document not found"
					}
				},
				"security": [
					{
						"banking_auth": ["write:documents"]
					}
				]
			}
		},
		"/Ecm/Documents/{id}/Status": {
			"get": {
				"tags": ["document"],
				"summary": "Get document status",
				"description": "Retrieve the status of a specific document",
				"operationId": "getDocumentStatus",
				"produces": ["application/json"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID of document to check status for",
						"required": true,
						"type": "string",
						"format": "uuid"
					}
				],
				"responses": {
					"200": {
						"description": "successful operation",
						"schema": {
							"type": "string"
						}
					},
					"400": {
						"description": "Invalid ID supplied"
					},
					"404": {
						"description": "Document not found"
					}
				},
				"security": [
					{
						"banking_auth": ["read:documents"]
					}
				]
			}
		}
	},
	"securityDefinitions": {
		"banking_auth": {
			"type": "oauth2",
			"authorizationUrl": "http://el-barka.runasp.net/oauth/dialog",
			"flow": "implicit",
			"scopes": {
				"write:aml": "modify AML screening records",
				"read:aml": "read AML screening records",
				"write:accounts": "modify accounts in your system",
				"read:accounts": "read your accounts",
				"write:customers": "modify customer records",
				"read:customers": "read customer records",
				"write:documents": "modify documents",
				"read:documents": "read documents"
			}
		},
		"api_key": {
			"type": "apiKey",
			"name": "api_key",
			"in": "header"
		}
	},
	"definitions": {
		"AmlScreening": {
			"type": "object",
			"required": ["riskLevel", "riskScore"],
			"properties": {
				"screeningId": {
					"type": "string",
					"format": "uuid"
				},
				"nationalID": {
					"type": "string",
					"maxLength": 14,
					"minLength": 0
				},
				"passportNo": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0
				},
				"nameAr": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0
				},
				"nameEn": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0
				},
				"riskScore": {
					"type": "integer",
					"format": "int32"
				},
				"riskLevel": {
					"type": "string",
					"maxLength": 10,
					"minLength": 0,
					"enum": ["low", "medium", "high"]
				},
				"hitsCount": {
					"type": "integer",
					"format": "int32"
				},
				"performedAt": {
					"type": "string",
					"format": "date-time"
				}
			},
			"xml": {
				"name": "AmlScreening"
			}
		},
		"CoreAccount": {
			"type": "object",
			"required": ["accountType", "cif", "currency"],
			"properties": {
				"accountNumber": {
					"type": "string",
					"maxLength": 20,
					"minLength": 0,
					"example": "1234567890"
				},
				"cif": {
					"type": "integer",
					"format": "int64"
				},
				"customer": {
					"$ref": "#/definitions/CoreCustomer"
				},
				"accountType": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0,
					"enum": ["savings", "current", "fixed_deposit", "loan"]
				},
				"currency": {
					"type": "string",
					"maxLength": 3,
					"minLength": 3,
					"example": "USD"
				},
				"debitBlocked": {
					"type": "boolean",
					"default": false
				},
				"productCode": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				}
			},
			"xml": {
				"name": "CoreAccount"
			}
		},
		"CoreAccountDTO": {
			"type": "object",
			"properties": {
				"accountNumber": {
					"type": "string"
				},
				"cif": {
					"type": "integer",
					"format": "int64"
				},
				"accountType": {
					"type": "string"
				},
				"currency": {
					"type": "string"
				},
				"debitBlocked": {
					"type": "boolean"
				},
				"productCode": {
					"type": "string"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"customer": {
					"$ref": "#/definitions/CoreCustomerDTO"
				}
			},
			"xml": {
				"name": "CoreAccountDTO"
			}
		},
		"CoreCustomer": {
			"type": "object",
			"required": ["branchCode", "dob", "gender", "mobile", "nameAr"],
			"properties": {
				"cif": {
					"type": "integer",
					"format": "int64"
				},
				"nationalID": {
					"type": "string",
					"maxLength": 14,
					"minLength": 0,
					"example": "12345678901234"
				},
				"passportNo": {
					"type": "string",
					"maxLength": 30,
					"minLength": 0
				},
				"nameAr": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"example": "محمد أحمد"
				},
				"nameEn": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"example": "Mohamed Ahmed"
				},
				"dob": {
					"type": "string",
					"format": "date"
				},
				"gender": {
					"type": "string",
					"enum": ["male", "female"]
				},
				"address": {
					"type": "string",
					"maxLength": 400,
					"minLength": 0
				},
				"mobile": {
					"type": "string",
					"maxLength": 20,
					"minLength": 0,
					"example": "+201234567890"
				},
				"email": {
					"type": "string",
					"maxLength": 200,
					"minLength": 0,
					"format": "email"
				},
				"branchCode": {
					"type": "string",
					"maxLength": 10,
					"minLength": 0,
					"example": "BR001"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"accounts": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/CoreAccount"
					}
				}
			},
			"xml": {
				"name": "CoreCustomer"
			}
		},
		"CoreCustomerDTO": {
			"type": "object",
			"properties": {
				"cif": {
					"type": "integer",
					"format": "int64"
				},
				"nationalID": {
					"type": "string"
				},
				"passportNo": {
					"type": "string"
				},
				"nameAr": {
					"type": "string"
				},
				"nameEn": {
					"type": "string"
				},
				"dob": {
					"type": "string",
					"format": "date"
				},
				"gender": {
					"type": "string"
				},
				"address": {
					"type": "string"
				},
				"mobile": {
					"type": "string"
				},
				"email": {
					"type": "string"
				},
				"branchCode": {
					"type": "string"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"accounts": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/CoreAccountDTO"
					}
				}
			},
			"xml": {
				"name": "CoreCustomerDTO"
			}
		},
		"EcmDocument": {
			"type": "object",
			"required": ["docType", "fileName", "folderId", "requestId"],
			"properties": {
				"documentId": {
					"type": "string",
					"format": "uuid"
				},
				"folderId": {
					"type": "string",
					"format": "uuid"
				},
				"folder": {
					"$ref": "#/definitions/EcmFolder"
				},
				"requestId": {
					"type": "string",
					"maxLength": 50,
					"minLength": 0,
					"example": "REQ001"
				},
				"docType": {
					"type": "string",
					"maxLength": 50,
					"minLength": 0,
					"enum": ["identity", "proof_of_income", "bank_statement", "contract", "other"]
				},
				"fileName": {
					"type": "string",
					"maxLength": 255,
					"minLength": 0,
					"example": "document.pdf"
				},
				"uploadedAt": {
					"type": "string",
					"format": "date-time"
				}
			},
			"xml": {
				"name": "EcmDocument"
			}
		},
		"EcmDocumentDTO": {
			"type": "object",
			"properties": {
				"documentId": {
					"type": "string",
					"format": "uuid"
				},
				"folderId": {
					"type": "string",
					"format": "uuid"
				},
				"requestId": {
					"type": "string"
				},
				"docType": {
					"type": "string"
				},
				"fileName": {
					"type": "string"
				},
				"uploadedAt": {
					"type": "string",
					"format": "date-time"
				},
				"folder": {
					"$ref": "#/definitions/EcmFolderDTO"
				}
			},
			"xml": {
				"name": "EcmDocumentDTO"
			}
		},
		"EcmFolder": {
			"type": "object",
			"required": ["cif", "requestId"],
			"properties": {
				"folderId": {
					"type": "string",
					"format": "uuid"
				},
				"cif": {
					"type": "integer",
					"format": "int64"
				},
				"requestId": {
					"type": "string",
					"maxLength": 50,
					"minLength": 0,
					"example": "REQ001"
				},
				"pathHint": {
					"type": "string",
					"maxLength": 500,
					"minLength": 0
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"documents": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/EcmDocument"
					}
				}
			},
			"xml": {
				"name": "EcmFolder"
			}
		},
		"EcmFolderDTO": {
			"type": "object",
			"properties": {
				"folderId": {
					"type": "string",
					"format": "uuid"
				},
				"cif": {
					"type": "integer",
					"format": "int64"
				},
				"requestId": {
					"type": "string"
				},
				"pathHint": {
					"type": "string"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"documents": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/EcmDocumentDTO"
					}
				}
			},
			"xml": {
				"name": "EcmFolderDTO"
			}
		}
	},
	"externalDocs": {
		"description": "Find out more about Banking API",
		"url": "http://el-barka.runasp.net"
	}
}
