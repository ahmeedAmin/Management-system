  "definitions": {
    "AmlScreening": {
      "required": [
        "riskLevel",
        "riskScore"
      ],
      "type": "object",
      "properties": {
        "screeningId": {
          "type": "string",
          "format": "uuid"
        },
        "nationalID": {
          "type": "string",
          "maxLength": 14,
          "minLength": 0
        },
        "passportNo": {
          "type": "string",
          "maxLength": 30,
          "minLength": 0
        },
        "nameAr": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0
        },
        "nameEn": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0
        },
        "riskScore": {
          "type": "integer",
          "format": "int32"
        },
        "riskLevel": {
          "type": "string",
          "maxLength": 10,
          "minLength": 0
        },
        "hitsCount": {
          "type": "integer",
          "format": "int32"
        },
        "performedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "CoreAccount": {
      "required": [
        "accountType",
        "cif",
        "currency"
      ],
      "type": "object",
      "properties": {
        "accountNumber": {
          "type": "string",
          "maxLength": 20,
          "minLength": 0
        },
        "cif": {
          "type": "integer",
          "format": "int64"
        },
        "customer": {
          "$ref": "#/definitions/CoreCustomer"
        },
        "accountType": {
          "type": "string",
          "maxLength": 30,
          "minLength": 0
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "minLength": 0
        },
        "debitBlocked": {
          "type": "boolean"
        },
        "productCode": {
          "type": "string",
          "maxLength": 30,
          "minLength": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "CoreAccountDTO": {
      "type": "object",
      "properties": {
        "accountNumber": {
          "type": "string"
        },
        "cif": {
          "type": "integer",
          "format": "int64"
        },
        "accountType": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "debitBlocked": {
          "type": "boolean"
        },
        "productCode": {
